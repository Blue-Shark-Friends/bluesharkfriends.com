<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', {title:about_data.title, description:about_data.description}) %>
</head>
<body>
  <%- include('../partials/topbar', {title:about_data.title}) %>

<div class="content" style="display: flex; flex-direction: column;">
  <%- include('../partials/header', {title:about_data.title, subheading: 'About'}) %>
<div style="text-align: left">
  <% about_data.about_bsf.split("\n").forEach(element => { %>
    <%= element %>
    <br />
  <% }); %>
  <br />
  Also, check out our <a href="/shiver">shiver</a>! Our shiver is our community of support. What we do wouldn't be possible without them.
  "Crewmates" are people who have a personal stake in our community. "Deckhands" are crewmates that want to help out and take on an independent contractual role.
  "Pirates" are those that have legal stake in Blue Shark Friends.
</div>

<% about_data.people.forEach(member => { %>
  <div>
    <h3><a href="<%= member.link_ref %>"><%= member.name %></a>
      <br /><small><i><%= member.title %></i></small>
    </h3>
    <h4 class="pronouns"><%= member.pronouns %></h4>
    <img class="about-img" src="<%= member.img_src %>" width="200px" height="267px" alt="<%= member.img_alt %>" style="object-fit: cover; <% if(member.name === "Juniper Lusby") { %>object-position: 0 -70px<% } %>"/>
    <div style="text-align: left;">
      <% if(member.name === "Hannah Parker"){ %>
        <%= member.bio %>
        <br /><br />
        If you want to get to know me a little better, here is a <a href="https://hannahtransmom.bluesharkfriends.com/">work-in-progress prototype web app</a> that I'm working on to better describe myself.
      <% } else { %>
        <% member.bio.split("\n").forEach(element => { %>
          <%= element %>
          <br />
        <% }); %>
      <% } %>
    </div>
  </div>
<% }); %>
<br /><br />
</div>

<%- include('../partials/footer') %>

</body>
</html>
