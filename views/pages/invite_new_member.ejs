																	<tr>
																		<td class="pad" align="center"><a href="https://home.bluesharkfriends.com/index.php/apps/forms/s/tf6a8ZzSENWtSRBa2TqETyrb" target="_blank" style="color:#d9d267;text-decoration:none;"><!--[if mso]>
